# PyInstaller / packaging output (regenerated locally)
build/
dist/
dist_build/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
# Virtual environment (scripts/install.sh uses .venv at repo root)
.venv/
venv/
env/

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo

# App local config at repo root (dev). These change while the app is
# used and differ per computer, so they must never be committed.
/state.json
/state.json.tmp
/state.json.corrupt*
/settings.json
/settings.json.tmp
/settings.json.corrupt*
/bookmarks.json
/bookmarks.json.tmp
/bookmarks.json.corrupt*
/bookmarks.last-good.json
/bookmarks.last-good.json.tmp
/bookmarks.last-good.json.corrupt*
/bookmarks.last.good.json
/bookmarks.last.good.json.tmp
/bookmarks.last.good.json.corrupt*
.git-account.json
.git-account.pat

# Runtime logs and scan cache (dev mode may write these at repo root)
scan_cache/
*.log
debug-*.log

# Legacy per-PC backups that used to live in the repo; current backups
# are under %APPDATA%\TotalCommanderClone\backups\ (never Git).
backup/settings/
